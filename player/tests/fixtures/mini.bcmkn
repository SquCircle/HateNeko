{
  "projectName": "mini",
  "version": "0.27.4",
  "stageSize": { "width": 562, "height": 900 },
  "styles": { "stylesDict": { "st1": { "id": "st1", "url": "", "name": "s1" } } },
  "scenes": {
    "scenesDict": {
      "sc1": {
        "id": "sc1", "name": "背景", "screenName": "屏幕",
        "styles": ["st1"], "currentStyleId": "st1",
        "actorIds": ["a1", "a2"], "nekoBlockJsonList": []
      }
    },
    "currentSceneId": "sc1", "sortList": ["sc1"]
  },
  "variables": {
    "variablesDict": {
      "v_count": { "id": "v_count", "name": "计数", "value": 0 },
      "v_flag":  { "id": "v_flag",  "name": "标志", "value": 0 },
      "v_total": { "id": "v_total", "name": "总计", "value": 0 },
      "v_done":  { "id": "v_done",  "name": "完成", "value": 0 }
    }
  },
  "broadcasts": { "broadcastsDict": { "sc1": ["go"] } },
  "actors": {
    "actorsDict": {
      "a1": {
        "id": "a1", "name": "猫", "position": { "x": 0, "y": 0 }, "rotation": 0,
        "scale": 100, "visible": true, "styles": ["st1"], "currentStyleId": "st1",
        "nekoBlockJsonList": [
          {
            "id": "h1", "type": "on_running_group_activated", "shield": false,
            "statements": { "DO": {
              "id": "n1", "type": "variables_set",
              "fields": { "variable": "v_count" },
              "inputs": { "value": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "0" } } },
              "next": {
                "id": "n2", "type": "repeat_n_times",
                "inputs": { "times": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "3" } } },
                "statements": { "DO": {
                  "id": "r1", "type": "change_variables",
                  "fields": { "variable": "v_count", "method": "increase" },
                  "inputs": { "n": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "1" } } },
                  "next": {
                    "id": "r2", "type": "wait",
                    "inputs": { "time": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "0.05" } } }
                  }
                } },
                "next": {
                  "id": "n3", "type": "self_broadcast",
                  "inputs": { "message": { "type": "broadcast_input", "is_shadow": true, "is_output": true, "fields": { "message": "go" } } },
                  "next": {
                    "id": "n4", "type": "controls_if",
                    "mutation": "<mutation elseif=\"0\" else=\"0\"></mutation>",
                    "inputs": {
                      "IF0": {
                        "type": "logic_compare", "is_output": true, "fields": { "OP": "GTE" },
                        "inputs": {
                          "A": { "type": "variables_get", "is_output": true, "fields": { "variable": "v_count" } },
                          "B": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "3" } }
                        }
                      }
                    },
                    "statements": { "DO0": {
                      "id": "c1", "type": "self_go_forward",
                      "inputs": { "steps": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "10" } } }
                    } },
                    "next": {
                      "id": "n5", "type": "variables_set",
                      "fields": { "variable": "v_done" },
                      "inputs": { "value": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "1" } } }
                    }
                  }
                }
              }
            } }
          },
          {
            "id": "h2", "type": "self_listen",
            "inputs": { "message": { "type": "broadcast_input", "is_shadow": true, "is_output": true, "fields": { "message": "go" } } },
            "statements": { "DO": {
              "id": "f1", "type": "variables_set",
              "fields": { "variable": "v_flag" },
              "inputs": { "value": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "1" } } }
            } }
          }
        ]
      },
      "a2": {
        "id": "a2", "name": "狗", "position": { "x": 100, "y": 0 }, "rotation": 0,
        "scale": 100, "visible": true, "styles": ["st1"], "currentStyleId": "st1",
        "nekoBlockJsonList": [
          {
            "id": "h3", "type": "self_listen",
            "inputs": { "message": { "type": "broadcast_input", "is_shadow": true, "is_output": true, "fields": { "message": "go" } } },
            "statements": { "DO": {
              "id": "g1", "type": "change_variables",
              "fields": { "variable": "v_total", "method": "increase" },
              "inputs": { "n": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "1" } } }
            } }
          }
        ]
      }
    }
  },
  "procedures": { "proceduresDict": {} },
  "audios": { "audiosDict": {}, "sortList": [], "currentAudioId": "" }
}
