{
  "projectName": "事件测试",
  "version": "0.27.4",
  "stageSize": { "width": 562, "height": 900 },
  "styles": { "stylesDict": { "st1": { "id": "st1", "url": "", "name": "占位" } } },
  "scenes": { "scenesDict": { "sc1": { "id": "sc1", "name": "背景", "screenName": "屏幕", "styles": ["st1"], "currentStyleId": "st1", "actorIds": ["sender", "l1", "l2", "lp"], "nekoBlockJsonList": [] } },
              "currentSceneId": "sc1", "sortList": ["sc1"] },
  "variables": { "variablesDict": {
    "v_go": { "id": "v_go", "name": "收到go", "value": 0 },
    "v_other": { "id": "v_other", "name": "收到other", "value": 0 },
    "v_after": { "id": "v_after", "name": "广播后", "value": 0 },
    "v_got": { "id": "v_got", "name": "收到内容", "value": "" },
    "v_waited": { "id": "v_waited", "name": "听者已完成等待", "value": 0 },
    "v_afterwait": { "id": "v_afterwait", "name": "广播并等待之后", "value": 0 }
  } },
  "actors": { "actorsDict": {
    "sender": { "id": "sender", "name": "发送者", "position": { "x": 0, "y": 0 }, "rotation": 0, "scale": 100, "visible": true,
      "styles": ["st1"], "currentStyleId": "st1",
      "nekoBlockJsonList": [ { "id": "h_s", "type": "on_running_group_activated", "statements": { "DO": {
        "id": "s1", "type": "self_broadcast",
        "inputs": { "message": { "type": "broadcast_input", "is_shadow": true, "fields": { "message": "go" } } },
        "next": { "id": "s2", "type": "variables_set", "fields": { "variable": "v_after" },
          "inputs": { "value": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "1" } } },
          "next": { "id": "s3", "type": "self_broadcast_with_param",
            "inputs": {
              "message": { "type": "broadcast_input", "is_shadow": true, "fields": { "message": "p" } },
              "param": { "type": "text", "is_shadow": true, "fields": { "TEXT": "hello" } } },
            "next": { "id": "s4", "type": "self_broadcast_and_wait",
              "inputs": { "message": { "type": "broadcast_input", "is_shadow": true, "fields": { "message": "wait" } } },
              "next": { "id": "s5", "type": "variables_set", "fields": { "variable": "v_afterwait" },
                "inputs": { "value": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "1" } } } } } } } } } } ] },
    "l1": { "id": "l1", "name": "听者1", "position": { "x": 0, "y": 0 }, "rotation": 0, "scale": 100, "visible": true,
      "styles": ["st1"], "currentStyleId": "st1",
      "nekoBlockJsonList": [
        { "id": "h_go", "type": "received_broadcast",
          "inputs": { "message": { "type": "broadcast_input", "is_shadow": true, "fields": { "message": "go" } } },
          "statements": { "DO": { "id": "t1", "type": "variables_set", "fields": { "variable": "v_go" },
            "inputs": { "value": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "1" } } } } } },
        { "id": "h_wait", "type": "received_broadcast",
          "inputs": { "message": { "type": "broadcast_input", "is_shadow": true, "fields": { "message": "wait" } } },
          "statements": { "DO": { "id": "t2", "type": "wait",
            "inputs": { "time": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "0.05" } } },
            "next": { "id": "t3", "type": "variables_set", "fields": { "variable": "v_waited" },
              "inputs": { "value": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "1" } } } } } } }
      ] },
    "l2": { "id": "l2", "name": "听者2", "position": { "x": 0, "y": 0 }, "rotation": 0, "scale": 100, "visible": true,
      "styles": ["st1"], "currentStyleId": "st1",
      "nekoBlockJsonList": [ { "id": "h_other", "type": "received_broadcast",
        "inputs": { "message": { "type": "broadcast_input", "is_shadow": true, "fields": { "message": "other" } } },
        "statements": { "DO": { "id": "u1", "type": "variables_set", "fields": { "variable": "v_other" },
          "inputs": { "value": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "1" } } } } } } ] },
    "lp": { "id": "lp", "name": "带内容听者", "position": { "x": 0, "y": 0 }, "rotation": 0, "scale": 100, "visible": true,
      "styles": ["st1"], "currentStyleId": "st1",
      "nekoBlockJsonList": [ { "id": "h_p", "type": "self_listen_with_param",
        "inputs": { "message": { "type": "broadcast_input", "is_shadow": true, "fields": { "message": "p" } },
                   "param": { "type": "self_listen_param", "is_shadow": true, "fields": { "TEXT": "内容" } } },
        "statements": { "DO": { "id": "p1", "type": "variables_set", "fields": { "variable": "v_got" },
          "inputs": { "value": { "type": "self_listen_value", "is_shadow": true, "fields": { "TEXT": "内容" } } } } } } ] }
  } },
  "audios": { "audiosDict": {} },
  "procedures": { "proceduresDict": {} }
}
