{
  "projectName": "运动测试",
  "version": "0.27.4",
  "stageSize": { "width": 562, "height": 900 },
  "styles": { "stylesDict": { "st1": { "id": "st1", "url": "", "name": "占位" } } },
  "scenes": { "scenesDict": { "sc1": { "id": "sc1", "name": "背景", "screenName": "屏幕", "styles": ["st1"], "currentStyleId": "st1",
      "actorIds": ["mover"], "nekoBlockJsonList": [] } }, "currentSceneId": "sc1", "sortList": ["sc1"] },
  "variables": { "variablesDict": {
    "v_x1": { "id": "v_x1", "name": "移到后的x", "value": 0 },
    "v_y1": { "id": "v_y1", "name": "移到后的y", "value": 0 },
    "v_x2": { "id": "v_x2", "name": "设置x后", "value": 0 },
    "v_dir": { "id": "v_dir", "name": "朝向", "value": 0 },
    "v_fx": { "id": "v_fx", "name": "前进后x", "value": 0 },
    "v_fy": { "id": "v_fy", "name": "前进后y", "value": 0 },
    "v_glide_mid": { "id": "v_glide_mid", "name": "滑行中途x", "value": 0 },
    "v_glide_end": { "id": "v_glide_end", "name": "滑行结束x", "value": 0 }
  } },
  "actors": { "actorsDict": {
    "mover": { "id": "mover", "name": "移动者", "position": { "x": -999, "y": -999 }, "rotation": 0, "scale": 100, "visible": true,
      "styles": ["st1"], "currentStyleId": "st1",
      "nekoBlockJsonList": [ { "id": "h1", "type": "on_running_group_activated", "statements": { "DO": {
        "id": "m1", "type": "self_move_to",
        "inputs": { "x": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "100" } },
                    "y": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "50" } } },
        "next": { "id": "m2", "type": "variables_set", "fields": { "variable": "v_x1" },
          "inputs": { "value": { "type": "coordinate_of_sprite", "is_shadow": true, "fields": { "coordinate": "x" } } },
          "next": { "id": "m3", "type": "variables_set", "fields": { "variable": "v_y1" },
            "inputs": { "value": { "type": "coordinate_of_sprite", "is_shadow": true, "fields": { "coordinate": "y" } } },
            "next": { "id": "m4", "type": "self_set_position_x",
              "inputs": { "x": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "200" } } },
              "next": { "id": "m5", "type": "variables_set", "fields": { "variable": "v_x2" },
                "inputs": { "value": { "type": "coordinate_of_sprite", "is_shadow": true, "fields": { "coordinate": "x" } } },
                "next": { "id": "m6", "type": "self_glide_to",
                  "inputs": { "x": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "0" } },
                              "y": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "0" } },
                              "time": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "0.2" } } },
                  "next": { "id": "m7", "type": "variables_set", "fields": { "variable": "v_glide_mid" },
                    "inputs": { "value": { "type": "coordinate_of_sprite", "is_shadow": true, "fields": { "coordinate": "x" } } },
                    "next": { "id": "m8", "type": "wait",
                      "inputs": { "time": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "0.3" } } },
                      "next": { "id": "m9", "type": "variables_set", "fields": { "variable": "v_glide_end" },
                        "inputs": { "value": { "type": "coordinate_of_sprite", "is_shadow": true, "fields": { "coordinate": "x" } } },
                        "next": { "id": "m10", "type": "self_point_towards",
                          "inputs": { "degrees": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "90" } } },
                          "next": { "id": "m11", "type": "variables_set", "fields": { "variable": "v_dir" },
                            "inputs": { "value": { "type": "get_orientation", "is_shadow": true } },
                            "next": { "id": "m12", "type": "self_go_forward",
                              "inputs": { "steps": { "type": "math_number", "is_shadow": true, "fields": { "NUM": "100" } } },
                              "next": { "id": "m13", "type": "variables_set", "fields": { "variable": "v_fx" },
                                "inputs": { "value": { "type": "coordinate_of_sprite", "is_shadow": true, "fields": { "coordinate": "x" } } },
                                "next": { "id": "m14", "type": "variables_set", "fields": { "variable": "v_fy" },
                                  "inputs": { "value": { "type": "coordinate_of_sprite", "is_shadow": true, "fields": { "coordinate": "y" } } } } } } } } } } } } } } } } } } }
      ] }
  } },
  "audios": { "audiosDict": {} },
  "procedures": { "proceduresDict": {} }
}
