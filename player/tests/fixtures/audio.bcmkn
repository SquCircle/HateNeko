{
  "projectName": "audio测试",
  "version": "0.27.4",
  "stageSize": { "width": 562, "height": 900 },
  "styles": { "stylesDict": { "st1": { "id": "st1", "url": "", "name": "占位" } } },
  "scenes": {
    "scenesDict": {
      "sc1": { "id": "sc1", "name": "背景", "screenName": "屏幕", "styles": ["st1"], "currentStyleId": "st1", "actorIds": ["a1"], "nekoBlockJsonList": [] }
    },
    "currentSceneId": "sc1", "sortList": ["sc1"]
  },
  "variables": { "variablesDict": {
    "v_played": { "id": "v_played", "name": "已播放", "value": 0 },
    "v_done":   { "id": "v_done",   "name": "等待完成", "value": 0 },
    "v_stopped":{ "id": "v_stopped","name": "已停止", "value": 0 }
  } },
  "actors": { "actorsDict": {
    "a1": {
      "id": "a1", "name": "猫", "position": { "x": 0, "y": 0 }, "rotation": 0, "scale": 100,
      "visible": true, "styles": ["st1"], "currentStyleId": "st1",
      "nekoBlockJsonList": [
        { "id": "h1", "type": "on_running_group_activated",
          "statements": { "DO": {
            "id": "s1", "type": "play_audio",
            "fields": { "audio_id": "snd1" },
            "inputs": { "volume": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "100" } } },
            "next": {
              "id": "s2", "type": "variables_set",
              "fields": { "variable": "v_played" },
              "inputs": { "value": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "1" } } },
              "next": {
                "id": "s3", "type": "play_audio_and_wait",
                "fields": { "audio_id": "snd1" },
                "inputs": { "volume": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "50" } } },
                "next": {
                  "id": "s4", "type": "variables_set",
                  "fields": { "variable": "v_done" },
                  "inputs": { "value": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "1" } } },
                  "next": {
                    "id": "s5", "type": "stop_audio",
                    "fields": { "audio_id": "snd1" },
                    "next": {
                      "id": "s6", "type": "variables_set",
                      "fields": { "variable": "v_stopped" },
                      "inputs": { "value": { "type": "math_number", "is_shadow": true, "is_output": true, "fields": { "NUM": "1" } } }
                    }
                  }
                }
              }
            }
          } }
        }
      ]
    }
  } },
  "audios": { "audiosDict": { "snd1": { "id": "snd1", "name": "提示音", "url": "" } }, "sortList": [], "currentAudioId": "" },
  "procedures": { "proceduresDict": {} }
}
